# Copy to .env.local. Never commit a real .env file.
#
# Next.js loads .env.local natively for `pnpm dev` / `pnpm build`. The scripts/
# entry points and Vitest get it via the `with-env` script (dotenvx). Real
# environment variables take precedence over this file, and a missing
# .env.local is ignored -- which is why CI needs no copy of it.
#
# If port 5432 is taken locally, start Postgres with POSTGRES_PORT=<free-port>
# (docker-compose.yml reads it) and change both URLs below to match.

# Used by the app at runtime (lazily-initialised pool -- see src/server/db/pool.ts).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/policy_ledger

# Used by scripts/{migrate,seed,reset-db}.ts and the Vitest integration project's
# global-setup (which creates/drops policy_ledger_test off this same admin
# connection). The app database name is derived from it -- override with DATABASE_NAME.
POSTGRES_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# The frontend's single policy id -- a build-time constant, not a route param.
NEXT_PUBLIC_DEMO_POLICY_ID=POL-1001
