{
  "name": "policy-ledger-service",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "with-env": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE --quiet --",
    "test": "pnpm with-env vitest run",
    "test:watch": "pnpm with-env vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "pnpm with-env vitest run --project integration",
    "test:coverage": "pnpm with-env vitest run --coverage",
    "migrate": "pnpm with-env tsx scripts/migrate.ts",
    "db:seed": "pnpm with-env tsx scripts/seed.ts",
    "db:reset": "pnpm with-env tsx scripts/reset-db.ts",
    "replay": "pnpm with-env tsx scripts/replay.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.21.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^7",
    "typescript-eslint": "^8.67.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
